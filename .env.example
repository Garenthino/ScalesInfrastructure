# Scales FastAPI Backend — Environment Configuration

# Application
APP_NAME=ScalesAPI
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://scales:scales@localhost:5432/scales
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT
JWT_SECRET_KEY=change-me-in-production-use-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting (Redis optional for prod; in-memory for dev)
REDIS_URL=redis://localhost:6379/0

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
