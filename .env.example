# Scales FastAPI Backend — Environment Configuration

# Application
APP_NAME=ScalesAPI
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://scales:scales@localhost:5432/scales
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT
JWT_SECRET_KEY=change-me-in-production-use-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (optional for dev; required for prod horizontal scaling)
REDIS_URL=redis://localhost:6379/0

# Socket.IO Gateway (Node.js) — required for multi-container broadcast
GATEWAY_URL=http://localhost:3001
GATEWAY_INTERNAL_SECRET=change-me-in-production-use-at-least-32-characters

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security hardening
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
SECURITY_HEADERS_ENABLED=true
REQUEST_MAX_BODY_SIZE_MB=1.0
CORS_ORIGINS_PROD=https://dancingdragonservices.com,https://www.dancingdragonservices.com

# Stripe (optional)
STRIPE_TEST_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Error tracking (optional)
SENTRY_DSN=
